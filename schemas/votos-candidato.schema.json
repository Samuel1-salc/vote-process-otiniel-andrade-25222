{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/votos-candidato.schema.json",
  "title": "Votação de candidato por seção",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_schema",
    "versao_contrato",
    "gerado_em",
    "candidato",
    "eleicao",
    "resumo",
    "fonte",
    "registros"
  ],
  "properties": {
    "versao_schema": {"const": "1.0.0"},
    "versao_contrato": {"type": "string", "minLength": 1},
    "gerado_em": {"type": "string", "format": "date-time"},
    "candidato": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numero", "nome", "cargo"],
      "properties": {
        "numero": {"type": "string", "pattern": "^[0-9]+$"},
        "nome": {"type": "string", "minLength": 1},
        "cargo": {"type": "string", "minLength": 1}
      }
    },
    "eleicao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ano", "turno", "uf"],
      "properties": {
        "ano": {"type": "integer", "minimum": 1},
        "turno": {"type": "integer", "minimum": 1},
        "uf": {"type": "string", "pattern": "^[A-Z]{2}$"}
      }
    },
    "resumo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registros", "municipios", "registros_com_secao_agregada", "total_votos"],
      "properties": {
        "registros": {"type": "integer", "minimum": 1},
        "municipios": {"type": "integer", "minimum": 1},
        "registros_com_secao_agregada": {"type": "integer", "minimum": 0},
        "total_votos": {"type": "integer", "minimum": 0}
      }
    },
    "fonte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "url", "algoritmo_hash", "hash_arquivo_origem"],
      "properties": {
        "nome": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "algoritmo_hash": {"type": "string", "minLength": 1},
        "hash_arquivo_origem": {"type": "string", "minLength": 1}
      }
    },
    "registros": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidade", "codigo_municipio_tse", "zona", "secao", "secoes_agregadas", "votos"],
        "properties": {
          "cidade": {"type": "string", "minLength": 1},
          "codigo_municipio_tse": {"type": "string", "pattern": "^[0-9]+$"},
          "zona": {"type": "string", "pattern": "^[0-9]+$"},
          "secao": {"type": "string", "pattern": "^[0-9]+$"},
          "secoes_agregadas": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[0-9]+$"},
            "uniqueItems": true
          },
          "votos": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
